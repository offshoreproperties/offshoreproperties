# Supabase (required for app + server)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Vite client (same project as above)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Public site URL (OAuth redirects in SSR/build; optional locally — defaults to window.origin)
VITE_SITE_URL=http://localhost:8080
# Production: https://offshoreproperties.co.ke

# Render: set all vars above in Dashboard → Environment; start command is npm run start

# Admin portal (/adminlogin) — server-only, never expose as VITE_*
ADMIN_PASSWORD=change-me-to-a-strong-password

# Google Maps — https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Geocoding API, Maps Embed API
# Under key restrictions → HTTP referrers: localhost:8080/* and your production domain
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAP_ID=your_cloud_map_id

# AI property assistant (use ONE — first match wins)
ANTHROPIC_API_KEY=sk-ant-your_key
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-your_openai_key
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash

# Or Lovable AI gateway (legacy)
LOVABLE_API_KEY=your_lovable_api_key

# --- Supabase Auth (Dashboard → Authentication) ---
# 1. Enable Email provider (confirm email on or off per your preference)
# 2. Enable Google provider → add Client ID + Secret from Google Cloud Console
# 3. URL Configuration (add EVERY domain users visit — missing URL = "redirect not allowed"):
#    Site URL: https://offshoreproperties.co.ke
#    Redirect URLs (one per line):
#      http://localhost:8080/auth/callback
#      http://localhost:8080/auth/reset-password
#      https://offshoreproperties.co.ke/auth/callback
#      https://offshoreproperties.co.ke/auth/reset-password
#      https://www.offshoreproperties.co.ke/auth/callback
#      https://www.offshoreproperties.co.ke/auth/reset-password
# 4. Google Cloud → OAuth client → Authorized redirect URI:
#      https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback

# CLI: npm run db:push (Dashboard → Connect → Session pooler URI)
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# One-time Supabase project migration (scripts/migrate-supabase.mjs — do not commit keys)
# OLD_SUPABASE_URL=https://OLD_REF.supabase.co
# OLD_SUPABASE_SERVICE_ROLE_KEY=...
# NEW_SUPABASE_URL=https://NEW_REF.supabase.co
# NEW_SUPABASE_SERVICE_ROLE_KEY=...
